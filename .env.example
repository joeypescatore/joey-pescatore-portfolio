# Copy this file to .env.local for local dev (vercel dev), and set the same
# vars in the Vercel dashboard (Project -> Settings -> Environment Variables)
# for Production/Preview. Never commit real values — .env.local is gitignored.

# Required. Get one at https://openrouter.ai/settings/keys — set a credit
# limit on the key itself in that dashboard as a hard spend cap.
OPENROUTER_API_KEY=

# Optional. Defaults to openai/gpt-4o-mini if unset. Any OpenRouter model slug
# works — see https://openrouter.ai/models for current options/pricing.
OPENROUTER_MODEL=
